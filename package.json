{
  "name": "school-timetable-2027",
  "productName": "School Timetable 2027",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/run.ts",
    "stress": "tsx tests/stress.ts",
    "build:desktop": "vite build --mode desktop",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win dir --x64 && node tools/build-installer.mjs",
    "license:keygen": "node tools/license/keygen.mjs",
    "license:issue": "node tools/license/issue.mjs",
    "icons": "python3 tools/make-icons.py",
    "installer": "node tools/build-installer.mjs",
    "installer-art": "python3 tools/make-installer-art.py",
    "dist:win:lite": "npm run build:desktop && node tools/build-lite.mjs && node tools/build-installer.mjs --lite",
    "test:lite": "node -e \"require('fs').copyFileSync('electron/license-public.pem','desktop-lite/license-public.pem')\" && cd desktop-lite && go test -mod=vendor ./"
  },
  "devDependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.27.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resedit": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "xlsx": "^0.18.5"
  },
  "description": "Монголын ерөнхий боловсролын сургуулийн хичээлийн хуваарь зохиох программ",
  "author": "School Timetable 2027",
  "main": "electron/main.cjs",
  "build": {
    "appId": "mn.schooltimetable.app2027",
    "productName": "School Timetable 2027",
    "executableName": "SchoolTimetable2027",
    "copyright": "© 2026 School Timetable 2027",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-desktop/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "afterPack": "build/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
